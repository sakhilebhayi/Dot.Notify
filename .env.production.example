APP_NAME="Dot.Notify"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=infodot
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Also required for REVERB_SCALING_ENABLED below, which lets multiple
# reverb:start processes share connection state via Redis pub/sub.
QUEUE_CONNECTION=redis

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@infodot.co.za"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Generate a unique app id/key/secret per environment -- never reuse the
# same credentials across environments or across other Dot platforms:
#   php -r 'echo random_int(100000, 999999);'   # REVERB_APP_ID
#   php -r 'echo bin2hex(random_bytes(20));'     # REVERB_APP_KEY
#   php -r 'echo bin2hex(random_bytes(32));'     # REVERB_APP_SECRET
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Public-facing values -- what browsers connect to (wss://your-domain.com),
# proxied by Nginx/Apache down to the internal process below. See the
# "WebSocket Reverse Proxy" section in README.md.
REVERB_HOST=your-domain.com
REVERB_PORT=443
REVERB_SCHEME=https

# Internal bind address/port for the `reverb:start` process itself (see
# deploy/reverb.service). Not internet-facing directly -- only the reverse
# proxy talks to this.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# Requires QUEUE_CONNECTION=redis above. Off by default until more than one
# reverb:start process is actually running.
REVERB_SCALING_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# InfoDot sign-in (signed redeem). This app has its own database, so InfoDot's
# one-time handoff token is proved by calling InfoDot rather than looked up here.
# INFODOT_SERVICE_SECRET must equal ECOSYSTEM_SECRET_NOTIFY in InfoDot's .env, and
# InfoDot must have this platform marked live. Blank = old local-token behaviour only.
INFODOT_REDEEM_URL=https://infodot.co.za/api/ecosystem/redeem
INFODOT_PLATFORM_KEY=notify
INFODOT_SERVICE_SECRET=
INFODOT_REDEEM_TIMEOUT=5
INFODOT_PROVISION_USERS=true

# Dot app ingest (POST /api/ingest/events). One secret per CALLING platform; the
# caller signs "{timestamp}.{raw body}" with HMAC-SHA256 and Notify verifies. Blank
# = that platform cannot call. Key = platform key upper-cased (see config/ecosystem.php).
# Generate: php -r 'echo bin2hex(random_bytes(32));'
# The matching secret goes in the calling app's own .env. The company must be
# linked first: php artisan infodot:link-team {team} {infodot-team-uuid}
NOTIFY_INGEST_SECRET_BILLING=
NOTIFY_INGEST_SECRET_FILES=
NOTIFY_INGEST_SECRET_HR=
NOTIFY_INGEST_SECRET_PROJECTS=
NOTIFY_INGEST_SECRET_TASKS=
NOTIFY_INGEST_RATE_LIMIT=120

# Delivery runs on the queue: a worker MUST be running (php artisan queue:work,
# see deploy/queue-worker.*). The scheduler's notify:dispatch-queued only enqueues.
